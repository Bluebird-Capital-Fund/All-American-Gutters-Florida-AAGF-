# Required: same Sanity project as sanity-studio (create at https://www.sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Write token for `npm run content:aagf` / `build:vercel` (patch Sanity when set). On Vercel, without
# these, `build:vercel` skips content:aagf and only runs `astro build` (deploy still succeeds).
# Set SANITY_REQUIRE_CONTENT_PATCH=1 on Vercel to fail deploys if the token is missing.
# SANITY_API_WRITE_TOKEN=
# SANITY_API_TOKEN=

# Production canonical URL — trailing slash optional (code strips it). Example:
# PUBLIC_SITE_URL=https://aaguttersflorida.com
PUBLIC_SITE_URL=

# reCAPTCHA v3 site key (public). Vercel name: RECAPTCHA_PUBLIC_KEY (preferred) or PUBLIC_RECAPTCHA_SITE_KEY.
RECAPTCHA_PUBLIC_KEY=
# PUBLIC_RECAPTCHA_SITE_KEY=

# reCAPTCHA v3 secret (server only — Vercel env for /api/lead).
RECAPTCHA_SECRET_KEY=

# Zapier catch hook for lead forms (server only). Vercel name: ZAPIER_WEBHOOK_PRIMARY (preferred).
# ZAPIER_WEBHOOK_PRIMARY=
# ZAPIER_WEBHOOK_URL=

# Mapbox token (public read token for address autofill on lead forms).
PUBLIC_MAPBOX_TOKEN=

# Optional: minimum score 0.0–1.0 (default 0.5).
# RECAPTCHA_MIN_SCORE=0.5
