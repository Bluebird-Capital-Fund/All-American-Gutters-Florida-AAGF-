---
import { externalLinkAttrs } from '../lib/external-link.js'
import { asStr, estimateCtaLabel, ESTIMATE_CTA_LABEL } from '../lib/sanity-strings.js'

const {
  phoneTel,
  callLabel,
  estimateHref = '#contact',
  estimateLabel = ESTIMATE_CTA_LABEL,
  class: className = 'why-choose-actions services-hub-ctas',
} = Astro.props
const estimateLabelDisplay = estimateCtaLabel(estimateLabel)
---

<div class={className}>
  <a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg cta1-primary-call">
    {callLabel}
  </a>
  <a
    href={estimateHref}
    class="btn btn-outline btn-lg request-estimate"
    {...externalLinkAttrs(asStr(estimateHref))}
  >
    {estimateLabelDisplay}
  </a>
</div>
