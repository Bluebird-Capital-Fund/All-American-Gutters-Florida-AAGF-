---
import { SMS_FORM_CHECKBOX_LABEL } from '../lib/sms-consent.js'
---

<div class="sms-consent-field">
  <label class="sms-consent-label">
    <input
      type="checkbox"
      name="smsConsent"
      value="yes"
      required
      data-sms-consent
    />
    <span class="sms-consent-text">{SMS_FORM_CHECKBOX_LABEL}</span>
  </label>
</div>
