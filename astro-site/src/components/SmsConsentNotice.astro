---
import { SMS_FORM_NOTICE, SMS_FOOTER_NOTICE } from '../lib/sms-consent.js'

const { variant = 'form' } = Astro.props
const isFooter = variant === 'footer'
const text = isFooter ? SMS_FOOTER_NOTICE : SMS_FORM_NOTICE
---

<p class:list={['sms-consent-notice', isFooter && 'sms-consent-notice--footer']}>
  {text}
  {' '}
  <a href="/privacy-policy/">Privacy Policy</a>
  {' · '}
  <a href="/terms-of-service/">Terms of Service</a>
</p>
