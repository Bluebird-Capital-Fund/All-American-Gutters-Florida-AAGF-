---
import { AAGF_SERVICE_AREA_CITIES } from '../lib/aagf-service-area-cities.js'
import { SERVICE_AREA_GBP_HEADLINE, SERVICE_AREA_GBP_INTRO } from '../lib/service-area-gbp-intro.js'
import { asStr, applyTemplate } from '../lib/sanity-strings.js'

const { settings = {}, homePage = {}, companyName = 'All American Gutters' } = Astro.props

const serviceArea = homePage?.serviceArea ?? {}
const mapEmbedUrl = asStr(settings?.mapEmbedUrl)
const mapIframeTitle =
  applyTemplate(asStr(serviceArea?.mapIframeTitleTemplate), { companyName }) ||
  `${companyName} South Florida service map`
---

{
  mapEmbedUrl ? (
    <section id="service-area" class="section service-area service-area--home">
      <div class="container">
        <div class="why-eyebrow">{asStr(serviceArea?.eyebrow) || 'Where we work'}</div>
        <h2 class="section-title">{SERVICE_AREA_GBP_HEADLINE}</h2>
        <p class="section-lead service-area-intro">{SERVICE_AREA_GBP_INTRO}</p>
        <div class="service-area-grid service-area-grid--stacked">
          <div class="map-wrap">
            <iframe
              src={mapEmbedUrl}
              width="600"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={mapIframeTitle}
            />
          </div>
          <div class="cities-list cities-list--below">
            <div class="service-area-counties-row">
              <p class="cities-label">Counties we serve</p>
              <ul class="service-area-counties-inline">
                <li>Broward County</li>
                <li>Palm Beach County</li>
              </ul>
            </div>
            <p class="cities-label">{asStr(serviceArea?.citiesLabel) || 'South Florida communities'}</p>
            <nav
              class="cities-nav cities-nav--inline"
              aria-label={asStr(serviceArea?.citiesNavAriaLabel) || 'South Florida communities'}
            >
              {AAGF_SERVICE_AREA_CITIES.map((c) => (
                <a href={c.href}>{c.name}</a>
              ))}
            </nav>
          </div>
        </div>
      </div>
    </section>
  ) : null
}
