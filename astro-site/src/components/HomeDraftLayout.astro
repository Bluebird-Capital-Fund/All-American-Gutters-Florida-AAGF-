---
import HomeDraftPage from './HomeDraftPage.astro'
import { getSiteSettings, getHomePage } from '../lib/site-settings.js'

const [settings, homePage] = await Promise.all([getSiteSettings(), getHomePage()])
---

{homePage ? (
  <HomeDraftPage settings={settings} homePage={homePage} />
) : (
  <html lang="en">
    <body>
      <main style="padding: 2rem; font-family: system-ui, sans-serif;">
        <h1>Home page not configured</h1>
        <p>Open Sanity Studio → Home page, add content, and publish before the draft can render.</p>
      </main>
    </body>
  </html>
)}
