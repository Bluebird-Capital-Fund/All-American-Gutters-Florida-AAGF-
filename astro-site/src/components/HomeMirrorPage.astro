---
import BaseLayout from '../layouts/BaseLayout.astro'
import OfferBarInner from '../components/OfferBarInner.astro'
import UniquePointIcon from '../components/UniquePointIcon.astro'
import FooterSocialIcon from '../components/FooterSocialIcon.astro'
import FooterContactInfo from '../components/FooterContactInfo.astro'
import FooterSupportBar from '../components/FooterSupportBar.astro'
import SmsConsentNotice from './SmsConsentNotice.astro'
import FooterHoursRow from '../components/FooterHoursRow.astro'
import ReviewsSummaryBar from '../components/ReviewsSummaryBar.astro'
import { externalLinkAttrs } from '../lib/external-link.js'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../lib/footer-contact-heading.js'
import { mergeHeaderFromSettings } from '../lib/site-settings.js'
import {
  asStr,
  asStrArray,
  applyTemplate,
  escapeHtml,
  mediaUrl,
  statLookup,
} from '../lib/sanity-strings.js'
import { inlineHeroBgStyle, inlineServicesBgStyle } from '../lib/brand-surfaces.js'
import { aagfNavLogoUrl, aagfSiteLogoUrl } from '../lib/brand-logos.js'
import { assertSanityHomepage } from '../lib/assert-sanity-homepage.js'
import { projectSlideLocation } from '../lib/project-slide-locations.js'
import { sanitizeCmsHtml } from '../lib/sanitize-cms-html.js'
import SiteBreadcrumbs from './SiteBreadcrumbs.astro'
import SiteHeaderNav from './SiteHeaderNav.astro'
import { lpSectionHeadline } from '../lib/lp-section-headlines.js'
import { SERVICE_AREA_GBP_HEADLINE } from '../lib/service-area-gbp-intro.js'

/** @typedef {{ slug: string, keyword: string }} LpConfig */

const { settings, homePage, lp } = Astro.props

assertSanityHomepage(settings, homePage)

const isLp = !!(lp?.slug?.trim() && lp?.keyword?.trim())
const isHomeOnly = !isLp
const lpSlug = isLp ? lp.slug.trim() : ''
const lpKeyword = isLp ? lp.keyword.trim() : ''
const heroLeadFormId = isLp ? `lp-${lpSlug}-hero` : 'hero'
const footerLeadFormId = isLp ? `lp-${lpSlug}-footer` : 'footer'
const isKeywordLp = isLp
const lpHeadline = (h) => lpSectionHeadline(h, lpKeyword, { active: isKeywordLp })

const business = settings.business
const meta = settings.meta
const statsValues = settings.statsValues
const mapEmbedUrl = asStr(settings.mapEmbedUrl)

const companyName = asStr(business?.companyName) || 'All American Gutters'
const phoneDisplay = asStr(business?.phoneDisplay)
const tel = asStr(business?.phoneTel)
const email = asStr(business?.email)
const address = asStr(business?.addressShort)
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business?.descriptionShort)
const copyrightHref = asStr(business?.copyrightSiteUrl)
const navLogoUrl = aagfNavLogoUrl()
const siteLogoUrl = aagfSiteLogoUrl()

const pageTitle = asStr(meta?.title)
const pageDescription = asStr(meta?.description)

const hp = homePage
const header = mergeHeaderFromSettings(settings, hp.header)
const offerBar = header?.offerBar
const navItems = header?.navItems
const hero = hp.hero
const brandsMarquee = hp.brandsMarquee
const projects = hp.projects
const whyChoose = hp.whyChoose
const whyStamp = whyChoose?.stamp
const whyCtas = whyChoose?.ctas
const services = hp.services
const servicesItems = Array.isArray(services?.items) ? services.items : []
const about = hp.about
const aboutVideo = about?.video
const uniquePoints = hp.uniquePoints
const statsBar = hp.statsBar
const contactBanner = hp.contactBanner
const reviews = settings?.reviews ?? hp.reviews
const reviewsSummary = reviews?.summary
const serviceArea = hp.serviceArea
const team = hp.team
const faq = hp.faq
const footerEstimate = settings?.footerEstimate ?? hp.footerEstimate
const footerEstimateFields = footerEstimate?.formFields
const footerBrand = settings?.footerBrand ?? hp.footerBrand
const footerColumns = settings?.footerColumns ?? hp.footerColumns
const footerSupport = settings?.footerSupport ?? hp.footerSupport
const formsCfg = settings?.forms ?? {}

const lpHeroH1 = isLp ? `Summer Special! Save Money Today On ${lpKeyword}.` : ''
const heroDisplayHeadline = isLp ? lpHeroH1 : asStr(hero?.headline)
const lpFormMainHeading = isLp ? `Get Special Pricing On ${lpKeyword}` : ''
const documentTitle = isLp ? `${lpKeyword} — ${pageTitle}` : pageTitle
const documentDescription = isLp ? `${lpKeyword}. ${pageDescription}`.trim() : pageDescription
const servicesHeadlineDisplay = lpHeadline(asStr(services?.headline))
const projectsHeadlineDisplay = lpHeadline(asStr(projects?.headline) || 'Recent South Florida Gutter Services')
const whyChooseHeadlineDisplay = lpHeadline(asStr(whyChoose?.headline))
const aboutHeadlineDisplay = lpHeadline(asStr(about?.headline))
const uniquePointsHeadlineDisplay = lpHeadline(asStr(uniquePoints?.headline))
const reviewsHeadlineDisplay = lpHeadline(asStr(reviews?.headline) || 'What South Florida Homeowners Say')
const faqHeadlineDisplay = lpHeadline(asStr(faq?.headline))
const teamHeadlineDisplay = lpHeadline(asStr(team?.headline))
const serviceAreaHeadlineDisplay = lpHeadline(SERVICE_AREA_GBP_HEADLINE)

const callLabelNav = applyTemplate(asStr(header?.callCtaTemplate), {
  phoneDisplay,
})

const callLabelHero = applyTemplate(asStr(hero?.callCtaTemplate), {
  phoneDisplay,
})

const logoAriaLabel = applyTemplate(asStr(header?.logoAriaLabelTemplate), {
  companyName,
})

const telLink = `tel:${tel}`

const homesCountDisplay = applyTemplate(asStr(whyStamp?.homesCountTemplate), {
  count: statLookup(statsValues, whyStamp?.homesCountKey),
})

const whyCallLabel = applyTemplate(asStr(whyCtas?.callTemplate), {
  phoneDisplay,
})

const aboutCallLabel = applyTemplate(asStr(about?.ctas?.callTemplate), {
  phoneDisplay,
})

const mapIframeTitle = applyTemplate(asStr(serviceArea?.mapIframeTitleTemplate), {
  companyName,
})

const layoutBg = hp.layoutBackgrounds
const heroBgSrc = asStr(layoutBg?.hero?.imageSrc)
const servicesBgSrc = asStr(layoutBg?.services?.imageSrc)
const uniquePointsBgSrc = asStr(layoutBg?.uniquePoints?.imageSrc)

const heroBgStyle = inlineHeroBgStyle(mediaUrl(heroBgSrc))

const servicesBgStyle = inlineServicesBgStyle(mediaUrl(servicesBgSrc))

const uniquePointsBgStyle = `background: var(--color-surface); background-image: url("${mediaUrl(uniquePointsBgSrc)}"); background-size: cover; background-position: center;`

const typedPhrases = asStrArray(hero?.typedPhrases).map((p) => p)

const aboutStillSrc = asStr(aboutVideo?.posterSrc) || asStr(whyChoose?.imageSrc) || ''

const copyrightTemplate = asStr(footerSupport?.copyrightTemplate)
const copyrightInnerHtml = sanitizeCmsHtml(
  copyrightTemplate
    .replace(/\{\{\s*year\s*\}\}/gi, '<span id="year"></span>')
    .replace(/\{\{\s*companyName\s*\}\}/gi, escapeHtml(companyName))
)

const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction)
const universalFormMethod = asStr(footerEstimate?.formMethod)
const universalFormHeading = asStr(footerEstimate?.headline)
const universalFormIntro = asStr(footerEstimate?.intro)
const universalFormHeadingDisplay = lpFormMainHeading || universalFormHeading
const universalFormIntroDisplay = universalFormIntro
const footerEstimateHeadingDisplay = lpFormMainHeading || asStr(footerEstimate?.headline)
const universalSubmitLabel = asStr(universalFormFields?.submitButton)
const universalFormKicker = asStr(formsCfg?.formKicker) || 'Free Design Consultation'
const universalFormAriaLabel = asStr(formsCfg?.formAriaLabel) || 'Lead form'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'

const serviceHref = (svc) => asStr(svc?.href).trim()
---

<BaseLayout
  title={documentTitle}
  description={documentDescription}
  theme={settings.theme}
  forms={{ submitPath: asStr(settings.forms?.submitPath) }}
  homeRevealAnimations
  preloadImageHref={mediaUrl(heroBgSrc)}
  robots={isLp ? 'noindex,nofollow' : undefined}
>
  <header class="header">
    <div class="offer-bar">
      <div class="offer-bar-inner">
        <OfferBarInner offerBar={offerBar} />
      </div>
    </div>

    <div class="header-nav">
      <SiteHeaderNav
        logoAriaLabel={logoAriaLabel}
        navLogoUrl={navLogoUrl}
        companyName={companyName}
        phoneTel={tel}
        callLabelNav={callLabelNav}
        navItems={navItems}
        navDdPrefix="nav"
        logoWidth={300}
        logoHeight={72}
      />
    </div>
  </header>
  {isLp ? <SiteBreadcrumbs variant="simple" label={lpKeyword} /> : null}
  <div id="header-nav-spacer" class="header-nav-spacer" aria-hidden="true"></div>

  <main>
    <section class="hero hero-split">
      <div class="hero-bg" style={heroBgStyle}></div>
      <div class="container hero-split-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow">{asStr(hero?.eyebrow)}</div>
          <h1 class:list={[{ 'lp-preserve-case': isKeywordLp }]}>{heroDisplayHeadline}</h1>
          <p class="hero-typed" aria-live="polite">
            <span id="hero-typed-text"></span><span class="hero-caret" aria-hidden="true">|</span>
          </p>
          <p class="hero-lead">{asStr(hero?.lead)}</p>
          <div class="hero-actions">
            <a href={telLink} class="btn btn-primary btn-lg cta1-primary-call">{callLabelHero}</a>
          </div>
        </div>
        <form
          class="hero-form"
          data-lead-form={heroLeadFormId}
          action={universalFormAction}
          method={universalFormMethod}
          aria-label={universalFormAriaLabel}
        >
          <div class="hero-form-heading">
            {!isLp ? <div class="hero-form-kicker">{universalFormKicker}</div> : null}
            <h2 class:list={[{ 'lp-preserve-case': isKeywordLp }]}>{universalFormHeadingDisplay}</h2>
          </div>
          <p class="hero-form-sub">{universalFormIntroDisplay}</p>
          <div class="hero-form-grid">
            <div class="hero-form-field">
              <label for={`${heroLeadFormId}-name`}>
                {asStr(universalFormFields?.nameLabel)}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id={`${heroLeadFormId}-name`} name="name" type="text" required autocomplete="name" />
            </div>
            <div class="hero-form-field">
              <label for={`${heroLeadFormId}-email`}>
                {asStr(universalFormFields?.emailLabel)}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input id={`${heroLeadFormId}-email`} name="email" type="email" required autocomplete="email" />
            </div>
            <div class="hero-form-field">
              <label for={`${heroLeadFormId}-phone`}>
                {asStr(universalFormFields?.phoneLabel)}{' '}
                <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
              </label>
              <input
                id={`${heroLeadFormId}-phone`}
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                maxlength="12"
                inputmode="numeric"
                pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                title="10-digit phone, e.g. 303-762-9841"
              />
            </div>
            <div class="hero-form-field">
              <label for={`${heroLeadFormId}-location`}>{asStr(universalFormFields?.cityLabel)}</label>
              <input id={`${heroLeadFormId}-location`} name="location" type="text" autocomplete="address-level2" />
            </div>
            <div class="hero-form-field hero-form-field-full">
              <label for={`${heroLeadFormId}-message`}>
                {asStr(universalFormFields?.projectDetailsLabel)}
              </label>
              <textarea id={`${heroLeadFormId}-message`} name="message" rows="3"></textarea>
            </div>
          </div>
          <div class="lead-form-honeypot-wrap" aria-hidden="true">
            <label for={`${heroLeadFormId}-website`}>Leave blank</label>
            <input type="text" id={`${heroLeadFormId}-website`} name="website" tabindex="-1" autocomplete="off" />
          </div>
          <p class="lead-form-status" data-lead-form-status role="status" aria-live="polite"></p>
          <SmsConsentNotice />
          <button type="submit" class="btn btn-primary btn-lg">{universalSubmitLabel}</button>
        </form>
      </div>
      <section class="brands-marquee" aria-label={asStr(brandsMarquee?.ariaLabel)}>
        <div class="brands-track">
          <div class="brands-inner">
            {[0, 1, 2].map((idx) => (
              <div class="brands-group" aria-hidden={idx > 0 ? 'true' : undefined}>
                {asStrArray(brandsMarquee?.brands).map((b) => (
                  <span class="brand-pill">{b}</span>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    </section>

    <section id="reviews" class="section google-reviews">
      <div class="container">
        <h2 class:list={['section-title', 'reviews-title', { 'lp-preserve-case': isKeywordLp }]}>
          {reviewsHeadlineDisplay}
        </h2>
        <ReviewsSummaryBar reviews={reviews} />
        <div class="testimonials-grid">
          {(Array.isArray(reviews?.testimonials) ? reviews.testimonials : []).slice(0, 4).map((t) => (
            <blockquote class="testimonial">
              <div class="review-brand review-brand-top">
                <img src={mediaUrl(asStr(t.avatarSrc))} alt={asStr(t.author)} class="review-avatar" />
                <div class="review-meta">
                  <strong>{asStr(t.author)}</strong>
                  <span class="review-time">{asStr(t.timeAgo)}</span>
                </div>
              </div>
              <img
                src={mediaUrl(asStr(reviewsSummary?.starsImageSrc))}
                alt={asStr(reviewsSummary?.starsImageAlt)}
                class="review-stars"
              />
              <p>&quot;{asStr(t.quote)}&quot;</p>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <section id="process" class="image-scroller" aria-label={asStr(projects?.sectionAriaLabel)}>
      <div class="container projects-head">
        <h2 class:list={['section-title', { 'lp-preserve-case': isKeywordLp }]}>{projectsHeadlineDisplay}</h2>
      </div>
      <div class="projects-carousel" id="projects-carousel">
        {projects?.slides?.map((slide) => {
          const loc = projectSlideLocation(slide)
          const label = `${asStr(slide.imageAlt)} — ${loc}`
          return (
            <article class="project-slide" data-location={loc} aria-label={label}>
              <img
                src={mediaUrl(asStr(slide.imageSrc))}
                alt={asStr(slide.imageAlt)}
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
              <div class="project-meta">
                <span class="project-pin" aria-hidden="true">📍</span>{' '}
                <span class="project-location-label">{loc}</span>
              </div>
            </article>
          )
        })}
      </div>
      <div class="projects-controls projects-controls-bottom" aria-label={asStr(projects?.controlsAriaLabel)}>
        <button type="button" class="project-nav" id="projects-prev" aria-label={asStr(projects?.prevAriaLabel)}>
          {asStr(projects?.prevLabel)}
        </button>
        <button type="button" class="project-nav" id="projects-next" aria-label={asStr(projects?.nextAriaLabel)}>
          {asStr(projects?.nextLabel)}
        </button>
      </div>
    </section>

    <section id="why-us" class="section why-simple">
      <div class="container why-choose-layout">
        <div class="why-choose-image-wrap">
          <img
            src={mediaUrl(asStr(whyChoose?.imageSrc))}
            alt={asStr(whyChoose?.imageAlt)}
            class="why-choose-image"
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
          <div class="why-choose-stamp">
            <strong>{homesCountDisplay}</strong>
            <span>{asStr(whyStamp?.line2)}</span>
            <span>{asStr(whyStamp?.line3)}</span>
          </div>
        </div>
        <div class="why-choose-content">
          <div class="why-eyebrow">{asStr(whyChoose?.eyebrow)}</div>
          <h2 class:list={['section-title', 'section-title-secondary', { 'lp-preserve-case': isKeywordLp }]}>
            {whyChooseHeadlineDisplay}
          </h2>
          <p class="section-lead" set:html={sanitizeCmsHtml(asStr(whyChoose?.lead))} />
          <ul class="why-choose-list">
            {whyChoose?.bullets?.map((b) => (
              <li>
                <strong>{asStr(b.title)}</strong>{' '}
                <span set:html={sanitizeCmsHtml(asStr(b.text))} />
              </li>
            ))}
          </ul>
          <p class="why-choose-note">{asStr(whyChoose?.note)}</p>
          <div class="why-choose-actions">
            <a href={telLink} class="btn btn-primary btn-lg">{whyCallLabel}</a>
            <a
              href={asStr(whyCtas?.estimateHref)}
              class="btn btn-outline btn-lg request-estimate"
              {...externalLinkAttrs(asStr(whyCtas?.estimateHref))}
            >
              {asStr(whyCtas?.estimate)}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="section services" style={servicesBgStyle}>
      <div class="container">
        <h2 class:list={['section-title', { 'lp-preserve-case': isKeywordLp }]}>{servicesHeadlineDisplay}</h2>
        <div class="services-grid">
          {servicesItems.map((svc) => (
            <article class="service-card">
              <a href={serviceHref(svc)} class="service-image-wrap" style="display:block; color:inherit; text-decoration:none;">
                <span class="service-number">{asStr(svc.number)}</span>
                <h3 class="service-title">{asStr(svc.title)}</h3>
                <p class="service-desc">{asStr(svc.description)}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about about-video">
      <div class="container about-grid">
        <div class="about-content">
          <div class="about-eyebrow">{asStr(about?.eyebrow)}</div>
          <h2 class:list={['section-title', { 'lp-preserve-case': isKeywordLp }]}>{aboutHeadlineDisplay}</h2>
          <p class="about-lead">{asStr(about?.lead)}</p>
          <ul class="about-list">
            {asStrArray(about?.bullets).map((line) => (
              <li>{line}</li>
            ))}
          </ul>
          <div class="about-video-actions">
            <a href={telLink} class="btn btn-primary btn-lg">{aboutCallLabel}</a>
            <a
              href={asStr(about?.ctas?.estimateHref)}
              class="btn btn-outline btn-lg request-estimate"
              {...externalLinkAttrs(asStr(about?.ctas?.estimateHref))}
            >
              {asStr(about?.ctas?.estimate)}
            </a>
          </div>
        </div>
        <div class="about-visual">
          <div class="media-card media-video about-static-visual">
            <img
              src={mediaUrl(aboutStillSrc)}
              alt={asStr(about?.headline)}
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section unique-points" style={uniquePointsBgStyle}>
      <div class="container">
        <div class="why-eyebrow">{asStr(uniquePoints?.eyebrow)}</div>
        <h2 class:list={['section-title', 'section-title-secondary', { 'lp-preserve-case': isKeywordLp }]}>
          {uniquePointsHeadlineDisplay}
        </h2>
        <div class="unique-grid">
          {uniquePoints?.items?.map((pt) => (
            <article class="result-item">
              <span class="result-value">
                <span class="result-icon" aria-hidden="true">
                  <UniquePointIcon iconId={asStr(pt.iconId)} />
                </span>
                {asStr(pt.title)}
              </span>
              <p>{asStr(pt.description)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="stats-thin" aria-label={asStr(statsBar?.ariaLabel)}>
      <div class="container stats-thin-grid">
        {statsBar?.items?.map((row) => (
          <div>
            <strong>{statLookup(statsValues, row.valueKey)}</strong>
            <span>{asStr(row.label)}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section contact-banner-split">
      <div class="container contact-banner-grid">
        <div class="contact-banner-copy">
          <h2 class="section-title">{asStr(contactBanner?.headline)}</h2>
          <p class="section-lead">{asStr(contactBanner?.paragraph1)}</p>
          <p class="section-lead">{asStr(contactBanner?.paragraph2)}</p>
          <div class="contact-banner-actions">
            <a href={telLink} class="contact-banner-phone">
              <img
                src={mediaUrl(asStr(contactBanner?.phoneIconSrc))}
                alt=""
                aria-hidden="true"
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
              />
              <span class="contact-banner-phone-number">{phoneDisplay}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="section faq-section" aria-labelledby={asStr(faq?.headingId)}>
      <div class="container">
        <div class="faq-panel">
          <h2 class:list={['section-title', 'section-title-secondary', { 'lp-preserve-case': isKeywordLp }]} id={asStr(faq?.headingId)}>
            {faqHeadlineDisplay}
          </h2>
          <div class="faq-list" data-faq-accordion>
            {faq?.items?.map((item, idx) => {
              const n = idx + 1
              const btnId = `faq-btn-${n}`
              const panelId = `faq-panel-${n}`
              return (
                <div class="faq-item">
                  <button
                    type="button"
                    class="faq-summary"
                    id={btnId}
                    aria-expanded="false"
                    aria-controls={panelId}
                  >
                    <span class="faq-question">{asStr(item.question)}</span>
                    <span class="faq-chevron" aria-hidden="true"></span>
                  </button>
                  <div
                    class="faq-answer-outer"
                    id={panelId}
                    role="region"
                    aria-labelledby={btnId}
                    aria-hidden="true"
                  >
                    <div class="faq-answer" set:html={sanitizeCmsHtml(asStr(item.answerHtml))} />
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>
    </section>

    <section id="team" class="section our-team">
      <div class="container">
        <h2 class:list={['section-title', { 'lp-preserve-case': isKeywordLp }]}>{teamHeadlineDisplay}</h2>
        <div class="team-carousel" id="team-carousel">
          <button type="button" class="team-nav team-nav-prev" id="team-prev" aria-label="Previous team members">
            ‹
          </button>
          <div class="team-carousel-viewport">
            <div class="team-carousel-track" id="team-carousel-track">
              {team?.members?.map((m) => {
                const memLoc = asStr(m.location)
                const personName = asStr(m.personName)
                return (
                  <article class:list={['team-card', personName && 'team-card--named']}>
                    <img
                      src={mediaUrl(asStr(m.imageSrc))}
                      alt={asStr(m.imageAlt)}
                      width="640"
                      height="480"
                      loading="lazy"
                      decoding="async"
                    />
                    {personName ? (
                      <>
                        <h3>{personName}</h3>
                        <p class="team-location">{asStr(m.name)}</p>
                      </>
                    ) : (
                      <>
                        <h3>{asStr(m.name)}</h3>
                        {memLoc ? <p class="team-location">{memLoc}</p> : null}
                      </>
                    )}
                    <p>{asStr(m.bio)}</p>
                  </article>
                )
              })}
            </div>
          </div>
          <button type="button" class="team-nav team-nav-next" id="team-next" aria-label="Next team members">
            ›
          </button>
        </div>
      </div>
    </section>

    <section id="service-area" class:list={['section', 'service-area', { 'service-area--home': isHomeOnly }]}>
      <div class="container">
        <div class="why-eyebrow">{asStr(serviceArea?.eyebrow)}</div>
        <h2 class:list={['section-title', { 'lp-preserve-case': isKeywordLp }]}>{serviceAreaHeadlineDisplay}</h2>
        <p class="section-lead service-area-intro" set:html={sanitizeCmsHtml(asStr(serviceArea?.intro))} />
        <div class="service-area-grid">
          <div class="map-wrap">
            <iframe
              src={mapEmbedUrl}
              width="600"
              height="400"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={mapIframeTitle}
            ></iframe>
          </div>
          <div class="cities-list">
            {isHomeOnly ? (
              <>
                <p class="cities-label service-area-home-counties-label">Counties we serve</p>
                <ul class="service-area-home-counties-list">
                  <li>Broward County</li>
                  <li>Palm Beach County</li>
                </ul>
                <p class="cities-label service-area-home-communities-label">{asStr(serviceArea?.citiesLabel)}</p>
                <nav class="cities-nav service-area-home-communities-nav" aria-label={asStr(serviceArea?.citiesNavAriaLabel)}>
                  {serviceArea?.cities?.map((c) => (
                    <a href={asStr(c.href)} {...externalLinkAttrs(asStr(c.href))}>
                      {asStr(c.name)}
                    </a>
                  ))}
                </nav>
              </>
            ) : (
              <>
                <p class="cities-label">{asStr(serviceArea?.citiesLabel)}</p>
                <nav class="cities-nav" aria-label={asStr(serviceArea?.citiesNavAriaLabel)}>
                  {serviceArea?.cities?.map((c) => (
                    <a href={asStr(c.href)} {...externalLinkAttrs(asStr(c.href))}>
                      {asStr(c.name)}
                    </a>
                  ))}
                </nav>
              </>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate" aria-labelledby="footer-estimate-heading">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class:list={['section-title', { 'lp-preserve-case': isKeywordLp }]} id="footer-estimate-heading">
              {footerEstimateHeadingDisplay}
            </h2>
            <p>{asStr(footerEstimate?.intro)}</p>
            <FooterContactInfo
              variant="estimate"
              phoneTel={tel}
              phoneDisplay={phoneDisplay}
              email={email}
              address={address}
              addressHref={addressHref}
            />
          </div>
          <form
            class="contact-form"
            data-lead-form={footerLeadFormId}
            action={universalFormAction}
            method={universalFormMethod}
          >
            <div class="contact-form-grid">
              <div class="contact-form-field">
                <label for={`${footerLeadFormId}-name`}>
                  {asStr(universalFormFields?.nameLabel)}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input type="text" id={`${footerLeadFormId}-name`} name="name" required autocomplete="name" />
              </div>
              <div class="contact-form-field">
                <label for={`${footerLeadFormId}-email`}>
                  {asStr(universalFormFields?.emailLabel)}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input type="email" id={`${footerLeadFormId}-email`} name="email" required autocomplete="email" />
              </div>
              <div class="contact-form-field">
                <label for={`${footerLeadFormId}-phone`}>
                  {asStr(universalFormFields?.phoneLabel)}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input
                  type="tel"
                  id={`${footerLeadFormId}-phone`}
                  name="phone"
                  required
                  autocomplete="tel"
                  maxlength="12"
                  inputmode="numeric"
                  pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                  title="10-digit phone, e.g. 303-762-9841"
                />
              </div>
              <div class="contact-form-field">
                <label for={`${footerLeadFormId}-location`}>{asStr(universalFormFields?.cityLabel)}</label>
                <input type="text" id={`${footerLeadFormId}-location`} name="location" autocomplete="address-level2" />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for={`${footerLeadFormId}-message`}>{asStr(universalFormFields?.projectDetailsLabel)}</label>
                <textarea id={`${footerLeadFormId}-message`} name="message" rows="4"></textarea>
              </div>
            </div>
            <div class="lead-form-honeypot-wrap" aria-hidden="true">
              <label for={`${footerLeadFormId}-website`}>Leave blank</label>
              <input type="text" id={`${footerLeadFormId}-website`} name="website" tabindex="-1" autocomplete="off" />
            </div>
            <p class="lead-form-status" data-lead-form-status role="status" aria-live="polite"></p>
            <SmsConsentNotice />
            <button type="submit" class="btn btn-primary btn-lg">{universalSubmitLabel}</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand-block footer-col">
          <img src={siteLogoUrl} alt={companyName} class="footer-logo" width="380" height="78" loading="lazy" decoding="async" />
          <p class="footer-address">{descriptionShort}</p>
          <div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>
            {footerBrand?.socialLinks?.map((s) => (
              <a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}>
                <FooterSocialIcon platform={asStr(s.platform)} />
              </a>
            ))}
          </div>
        </div>
        {footerColumns?.map((col) => (
          <div class="footer-col">
            <p class="footer-heading">{asStr(col.heading)}</p>
            {col.links?.length ? (
              <nav class="footer-links" aria-label={asStr(col.ariaLabel)}>
                {col.links.map((link) => (
                  <a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>
                    {asStr(link.label)}
                  </a>
                ))}
              </nav>
            ) : null}
            {isContactFooterColumnHeading(col.heading) ? (
              <FooterContactInfo
                variant="footer-column"
                phoneTel={tel}
                phoneDisplay={phoneDisplay}
                email={email}
                address={address}
                addressHref={addressHref}
              />
            ) : null}
            {col.hoursHeading ? (
              <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p>
            ) : null}
            {col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}
          </div>
        ))}
      </div>
    </div>
  </footer>

  <FooterSupportBar
    copyrightHref={copyrightHref}
    companyName={companyName}
    copyrightInnerHtml={copyrightInnerHtml}
    footerSupport={footerSupport}
  />
  <script
    type="application/json"
    id="homepage-typed-phrases"
    data-fallback-phrase={asStr(hero?.typedFallbackPhrase)}
    set:html={JSON.stringify(typedPhrases)}
  />
  <style is:global>
    main h1,
    main h2,
    main h3,
    .footer-heading {
      text-transform: capitalize;
    }
    .lp-preserve-case {
      text-transform: none !important;
    }
  </style>
</BaseLayout>
