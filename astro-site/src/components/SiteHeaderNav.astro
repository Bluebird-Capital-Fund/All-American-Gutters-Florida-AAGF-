---
import { externalLinkAttrs } from '../lib/external-link.js'
import { asStr } from '../lib/sanity-strings.js'

const {
  logoAriaLabel,
  navLogoUrl,
  companyName,
  phoneTel,
  callLabelNav,
  navItems = [],
  navDdPrefix = 'nav',
  logoWidth,
  logoHeight,
} = Astro.props

const items = Array.isArray(navItems) ? navItems : []
const tel = String(phoneTel || '').replace(/\s/g, '')
---

<div class="header-inner">
  <a href="/" class="logo" aria-label={logoAriaLabel}>
    <img
      src={navLogoUrl}
      alt={companyName}
      class="logo-img"
      {...logoWidth ? { width: logoWidth } : {}}
      {...logoHeight ? { height: logoHeight } : {}}
    />
  </a>
  <nav class="nav">
    {items.length > 0 ? (
      items.map((item, i) => {
        const label = asStr(item.label)
        const href = asStr(item.href)
        const dropdown = item.dropdown
        if (Array.isArray(dropdown) && dropdown.length > 0) {
          const ddId = `${navDdPrefix}-nav-dd-${i}`
          return (
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                type="button"
                class="nav-dropdown-toggle"
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls={ddId}
                id={`${ddId}-btn`}
              >
                {label}
                <span class="nav-dropdown-chevron" aria-hidden="true" />
              </button>
              <ul class="nav-dropdown-menu" id={ddId} role="menu">
                {dropdown.map((link) => (
                  <li role="none">
                    <a href={asStr(link.href)} role="menuitem" {...externalLinkAttrs(asStr(link.href))}>
                      {asStr(link.label)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        return (
          <a href={href || '#'} {...externalLinkAttrs(href || '')}>
            {label}
          </a>
        )
      })
    ) : (
      <>
        <a href="/">Home</a>
        <a href="/gutter-installation-south-florida/">Products & Services</a>
      </>
    )}
    <a href={`tel:${tel}`} class="btn btn-primary btn-lg">{callLabelNav}</a>
  </nav>
  <div class="header-actions">
    <a
      href={`tel:${tel}`}
      class="btn btn-primary header-call-mobile"
      aria-label={asStr(callLabelNav) || 'Call us'}
    >
      <svg class="header-call-mobile-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
          d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
          fill="currentColor"
        />
      </svg>
    </a>
    <button type="button" class="nav-toggle" aria-label="Open menu">
      <span />
      <span />
      <span />
    </button>
  </div>
</div>
