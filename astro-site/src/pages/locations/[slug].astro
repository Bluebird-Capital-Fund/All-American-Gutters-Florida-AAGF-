---
/**
 * Local SEO landing pages: canonical `/locations/{slug}/` (Sanity `locationPage`).
 */
import LocationPage from '../../components/LocationPage.astro'
import { sanity } from '../../lib/sanity.js'
import { getSiteSettings, getHomePage } from '../../lib/site-settings.js'
import { asStr } from '../../lib/sanity-strings.js'
import {
  getLocationPageFallback,
  SCRIPTED_LOCATION_SLUGS,
} from '../../lib/aagf-location-page-fallbacks/index.js'

export async function getStaticPaths() {
  try {
    const pages = await sanity.fetch(
      `*[_type == "locationPage" && defined(slug.current)]{"slug": slug.current}`,
    )
    const cmsSlugs = (Array.isArray(pages) ? pages : [])
      .map((p) => asStr(p?.slug))
      .filter(Boolean)
    const slugs = Array.from(new Set([...cmsSlugs, ...SCRIPTED_LOCATION_SLUGS]))
    return slugs.map((slug) => ({ params: { slug } }))
  } catch (err) {
    console.warn('[locations/[slug]] Failed to load location page slugs.', err)
    return SCRIPTED_LOCATION_SLUGS.map((slug) => ({ params: { slug } }))
  }
}

const slug = asStr(Astro.params?.slug)

let settings = {}
let homePage = {}
let locPage = null
try {
  ;[settings, homePage, locPage] = await Promise.all([
    getSiteSettings(),
    getHomePage(),
    sanity.fetch(`*[_type == "locationPage" && slug.current == $slug][0]`, { slug }),
  ])
} catch (err) {
  console.warn(`[locations/${slug}] Sanity fetch failed; using fallback when available.`, err)
}

if (!locPage) {
  locPage = getLocationPageFallback(slug)
} else {
  const fallback = getLocationPageFallback(slug)
  const cmsSections = Array.isArray(locPage?.contentSections) ? locPage.contentSections : []
  if (fallback && cmsSections.length === 0) {
    locPage = fallback
  }
}

if (!locPage) {
  throw new Error(`[locations/${slug}] Missing locationPage document and no build fallback.`)
}
---

<LocationPage slug={slug} settings={settings} homePage={homePage} locPage={locPage} />
