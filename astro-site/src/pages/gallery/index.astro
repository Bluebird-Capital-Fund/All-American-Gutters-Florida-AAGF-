---
import BaseLayout from '../../layouts/BaseLayout.astro'
import OfferBarInner from '../../components/OfferBarInner.astro'
import FooterSocialIcon from '../../components/FooterSocialIcon.astro'
import FooterHoursRow from '../../components/FooterHoursRow.astro'
import FooterContactInfo from '../../components/FooterContactInfo.astro'
import FooterSupportBar from '../../components/FooterSupportBar.astro'
import SmsConsentNotice from '../../components/SmsConsentNotice.astro'
import SiteBreadcrumbs from '../../components/SiteBreadcrumbs.astro'
import SiteHeaderNav from '../../components/SiteHeaderNav.astro'
import { externalLinkAttrs } from '../../lib/external-link.js'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../../lib/footer-contact-heading.js'
import { sanity } from '../../lib/sanity.js'
import { getSiteSettings, getHomePage, mergeHeaderFromSettings } from '../../lib/site-settings.js'
import { inlineHeroBgStyle } from '../../lib/brand-surfaces.js'
import { heroBackgroundFor } from '../../lib/hero-backgrounds.js'
import { aagfNavLogoUrl, aagfSiteLogoUrl } from '../../lib/brand-logos.js'
import { locationLabelFromImageSrc, projectSlideLocation } from '../../lib/project-slide-locations.js'
import { AAGF_GALLERY_EXTRA_SLIDES } from '../../lib/aagf-gallery-images.js'
import { asStr, applyTemplate, estimateCtaLabel, footerEstimateIntro, mediaUrl } from '../../lib/sanity-strings.js'

let settings = {}
let homePage = {}
let galleryPages = []
try {
  ;[settings, homePage, galleryPages] = await Promise.all([
    getSiteSettings(),
    getHomePage(),
    sanity.fetch(
      `*[_type == "galleryPage"]{
        headline,
        lead,
        "slug": slug.current,
        images
      }`
    ),
  ])
} catch (err) {
  console.warn('[gallery] Sanity fetch failed; using fallback placeholders.', err)
}

const business = settings?.business ?? {}
const header = mergeHeaderFromSettings(settings, homePage?.header)
const footerEstimate = settings?.footerEstimate ?? homePage?.footerEstimate ?? {}
const footerEstimateFields = footerEstimate?.formFields ?? {}
const formsCfg = settings?.forms ?? {}
const footerBrand = settings?.footerBrand ?? homePage?.footerBrand ?? {}
const footerColumns = settings?.footerColumns ?? homePage?.footerColumns ?? []
const footerSupport = settings?.footerSupport ?? homePage?.footerSupport ?? {}

const companyName = asStr(business.companyName) || 'All American Gutters'
const phoneDisplay = asStr(business.phoneDisplay) || '(303) 000-0000'
const phoneTel = asStr(business.phoneTel) || '3030000000'
const email = asStr(business.email) || 'hello@example.com'
const address = asStr(business.addressShort) || 'Deerfield Beach, FL'
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business.descriptionShort)
const copyrightHref = asStr(business.copyrightSiteUrl) || '#'
const navLogoUrl = aagfNavLogoUrl()
const siteLogoUrl = aagfSiteLogoUrl()

const callLabelNav = applyTemplate(asStr(header.callCtaTemplate), { phoneDisplay }) || phoneDisplay
const heroCallLabel = applyTemplate(asStr(homePage?.hero?.callCtaTemplate), { phoneDisplay }) || `Call: ${phoneDisplay}`
const logoAriaLabel = applyTemplate(asStr(header.logoAriaLabelTemplate), { companyName }) || companyName
const navItems = Array.isArray(header.navItems) ? header.navItems : []

const looksLegacyColorado = (value) => {
  const text = asStr(value).toLowerCase()
  if (!text) return false
  return (
    text.includes('mile high') ||
    text.includes('denver') ||
    text.includes('colorado') ||
    text.includes(', co') ||
    text.includes('-co-') ||
    text.includes('/images (mile high)/')
  )
}

/** Portfolio images under AAGF media. */
const isProjectGalleryImage = (src) => {
  const value = asStr(src).toLowerCase()
  if (!value) return false
  return (
    value.includes('/images (aagf)/') ||
    value.includes('media (aagf)/images (aagf)/') ||
    value.includes('/images (sgt)/') ||
    value.includes('media (sgt)/images (sgt)/') ||
    value.includes('all-american-gutters-') ||
    value.includes('sunlife-')
  )
}

const cleanProjectText = (value, fallback = '') => {
  const text = asStr(value).trim()
  if (!text) return fallback
  if (!looksLegacyColorado(text)) return text
  return fallback
}

const heroBgSrc = heroBackgroundFor('gallery')
const heroBgStyle = heroBgSrc ? inlineHeroBgStyle(mediaUrl(heroBgSrc)) : undefined

const allGalleryPages = Array.isArray(galleryPages) ? galleryPages : []
const primaryGalleryPage =
  allGalleryPages.find((p) => asStr(p?.slug) === 'gallery') ??
  allGalleryPages.find((p) => asStr(p?.slug) === 'projects') ??
  allGalleryPages[0] ??
  {}

const pageTitle = cleanProjectText(primaryGalleryPage?.headline, 'Projects | All American Gutters')
const pageDescription =
  'Completed gutter installs, repairs, and replacements across Broward and Palm Beach counties in South Florida.'
const heroEyebrow = 'Gallery'
const heroHeadline = cleanProjectText(
  primaryGalleryPage?.headline,
  'Recent South Florida Gutter Services',
)
const heroLead = cleanProjectText(
  primaryGalleryPage?.lead,
  'Simple gallery of completed gutter work across South Florida.'
)
const galleryImages = allGalleryPages.flatMap((p) => (Array.isArray(p?.images) ? p.images : []))
const homeProjectSlides = Array.isArray(homePage?.projects?.slides) ? homePage.projects.slides : []
const allProjectImages = [...AAGF_GALLERY_EXTRA_SLIDES, ...galleryImages, ...homeProjectSlides]
const seenImageKeys = new Set()

function galleryImageKey(src) {
  return asStr(src).split('/').pop().replace(/\.[a-z0-9]+$/i, '')
}

const images = allProjectImages.filter((img) => {
  const src = asStr(img?.imageSrc)
  const alt = asStr(img?.imageAlt)
  const location = asStr(img?.location)
  const key = galleryImageKey(src)
  if (!src || !key || seenImageKeys.has(key)) return false
  if (!isProjectGalleryImage(src)) return false
  if (looksLegacyColorado(src) || looksLegacyColorado(alt) || looksLegacyColorado(location)) return false
  // Drop CMS rows stuck on generic “South Florida” when the filename has a real city.
  if (location === 'South Florida' && !locationLabelFromImageSrc(src)) return false
  seenImageKeys.add(key)
  return true
})

/** Client-side lightbox (serialized in page script) */
const galleryItems = images.map((img) => ({
  src: mediaUrl(asStr(img.imageSrc)),
  alt: cleanProjectText(img.imageAlt, 'Project photo'),
  caption: cleanProjectText(projectSlideLocation(img), 'South Florida'),
}))

const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '#'
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalFormKicker = asStr(formsCfg?.formKicker) || 'Free Design Consultation'
const universalFormAriaLabel = asStr(formsCfg?.formAriaLabel) || 'Projects lead form'
const universalFormHeading = asStr(footerEstimate?.headline) || 'Get Started Today'
const universalFormIntro = footerEstimateIntro(footerEstimate?.intro)
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  theme={settings?.theme}
  forms={{ submitPath: asStr(settings?.forms?.submitPath) || '/api/lead' }}
>
  <header class="header">
    <div class="offer-bar">
      <div class="offer-bar-inner">
        <OfferBarInner offerBar={header?.offerBar} />
      </div>
    </div>
    <div class="header-nav">
      <SiteHeaderNav
        logoAriaLabel={logoAriaLabel}
        navLogoUrl={navLogoUrl}
        companyName={companyName}
        phoneTel={phoneTel}
        callLabelNav={callLabelNav}
        navItems={navItems}
        navDdPrefix="gallery"
      />
    </div>
  </header>

  <SiteBreadcrumbs />

  <main>
    <section class="hero hero-split">
      <div class="hero-bg" style={heroBgStyle}></div>
      <div class="container hero-split-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow">{heroEyebrow}</div>
          <h1>{heroHeadline}</h1>
          <p class="hero-lead">{heroLead}</p>
          <div class="hero-actions"><a href={`tel:${phoneTel}`} class="btn btn-primary btn-lg cta1-primary-call">{heroCallLabel}</a></div>
        </div>
        <form class="hero-form" data-lead-form="gallery-hero" action={universalFormAction} method={universalFormMethod} aria-label={universalFormAriaLabel}>
          <div class="hero-form-heading"><div class="hero-form-kicker">{universalFormKicker}</div><h2>{universalFormHeading}</h2></div>
          <p class="hero-form-sub">{universalFormIntro}</p>
          <div class="hero-form-grid">
            <div class="hero-form-field"><label for="gallery-name">{asStr(universalFormFields?.nameLabel) || 'Name'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="gallery-name" name="name" type="text" required autocomplete="name" /></div>
            <div class="hero-form-field"><label for="gallery-email">{asStr(universalFormFields?.emailLabel) || 'Email'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="gallery-email" name="email" type="email" required autocomplete="email" /></div>
            <div class="hero-form-field"><label for="gallery-phone">{asStr(universalFormFields?.phoneLabel) || 'Phone'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="gallery-phone" name="phone" type="tel" required autocomplete="tel" /></div>
            <div class="hero-form-field"><label for="gallery-location">{asStr(universalFormFields?.cityLabel) || 'City'}</label><input id="gallery-location" name="location" type="text" autocomplete="address-level2" /></div>
            <div class="hero-form-field hero-form-field-full"><label for="gallery-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label><textarea id="gallery-message" name="message" rows="3"></textarea></div>
          </div>
          <SmsConsentNotice />
          <button type="submit" class="btn btn-primary btn-lg">{estimateCtaLabel(universalFormFields?.submitButton)}</button>
        </form>
      </div>
    </section>

    <section class="section secondary-page-section" aria-labelledby="projects-intro-heading">
      <div class="container page-split page-split--media-end">
        <div class="secondary-prose">
          <h2 class="section-title section-title-secondary" id="projects-intro-heading">Projects across South Florida</h2>
          <p>
            Browse a rotating set of installs from our crews—seamless aluminum, copper accents, and downspout runs tied into drainage systems. Every photo is a completed job after the final walkthrough and cleanup.
          </p>
          <p>
            Click any thumbnail to open the full-screen gallery. Use the arrow keys or on-screen controls to browse the images, and press Esc to close the gallery. On mobile, swipe-friendly controls keep browsing quick.
          </p>
          <p>
            Ready for something similar in your home? Note the neighborhood or style you like when you <a href="#contact">request a free design consultation</a>—we will align material colors and profiles to match your roofline and siding.
          </p>
        </div>
        <figure class="page-split__media">
          <img
            src={mediaUrl('Media (AAGF)/Images (AAGF)/all-american-gutters-gutter-installation-deerfield-beach-fl-front-entry-gutters.webp')}
            alt="Front entry gutters and downspouts on a Deerfield Beach, FL home"
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section projects-gallery-section">
      <div class="container">
        {images.length > 0 ? (
          <>
            <p class="projects-gallery-hint">Click a photo to view larger. Use arrows or keyboard to browse.</p>
            <div class="projects-gallery-grid">
              {images.map((img, i) => (
                <button
                  type="button"
                  class="projects-gallery-thumb"
                  data-photo-index={i}
                  aria-label={`Open project photo ${i + 1} of ${images.length} in gallery viewer`}
                >
                  <span class="projects-gallery-thumb-img-wrap">
                    <img
                      src={mediaUrl(asStr(img.imageSrc))}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="480"
                    />
                  </span>
                  <span class="projects-gallery-thumb-caption">{cleanProjectText(projectSlideLocation(img), 'South Florida')}</span>
                </button>
              ))}
            </div>

            <div
              id="projects-lightbox"
              class="projects-lightbox"
              hidden
              role="dialog"
              aria-modal="true"
              aria-label="Project photo gallery"
            >
              <button
                type="button"
                class="projects-lightbox-backdrop"
                data-lightbox-close
                tabindex="-1"
                aria-label="Close gallery"
              />
              <div class="projects-lightbox-panel">
                <button type="button" class="projects-lightbox-close" data-lightbox-close aria-label="Close gallery">
                  <span aria-hidden="true">×</span>
                </button>
                <p class="projects-lightbox-index" aria-live="polite" />
                <button type="button" class="projects-lightbox-nav projects-lightbox-prev" aria-label="Previous photo">
                  <span aria-hidden="true">‹</span>
                </button>
                <figure class="projects-lightbox-figure">
                  <img class="projects-lightbox-img" src="" alt="" />
                  <figcaption class="projects-lightbox-caption" />
                </figure>
                <button type="button" class="projects-lightbox-nav projects-lightbox-next" aria-label="Next photo">
                  <span aria-hidden="true">›</span>
                </button>
              </div>
            </div>
          </>
        ) : (
          <p>No project images added yet.</p>
        )}
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title">{asStr(footerEstimate?.headline) || 'Need Gutter Help in South Florida?'}</h2>
            <p>{asStr(footerEstimate?.intro) || 'Contact us for fast service and straightforward estimates.'}</p>
            <FooterContactInfo variant="estimate" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} />
          </div>
          <form class="contact-form" data-lead-form="gallery-footer" action={universalFormAction} method={universalFormMethod}>
            <div class="contact-form-grid">
              <div class="contact-form-field"><label for="contact-name">{asStr(universalFormFields?.nameLabel) || 'Name'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-name" name="name" type="text" required autocomplete="name" /></div>
              <div class="contact-form-field"><label for="contact-email">{asStr(universalFormFields?.emailLabel) || 'Email'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-email" name="email" type="email" required autocomplete="email" /></div>
              <div class="contact-form-field"><label for="contact-phone">{asStr(universalFormFields?.phoneLabel) || 'Phone'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="contact-phone" name="phone" type="tel" required autocomplete="tel" /></div>
              <div class="contact-form-field"><label for="contact-location">{asStr(universalFormFields?.cityLabel) || 'City'}</label><input id="contact-location" name="location" type="text" autocomplete="address-level2" /></div>
              <div class="contact-form-field contact-form-field-full"><label for="contact-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label><textarea id="contact-message" name="message" rows="4"></textarea></div>
            </div>
            <SmsConsentNotice />
            <button type="submit" class="btn btn-primary btn-lg">{estimateCtaLabel(footerEstimateFields?.submitButton)}</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container"><div class="footer-inner"><div class="footer-brand-block footer-col"><img src={siteLogoUrl} alt={companyName} class="footer-logo" /><p class="footer-address">{descriptionShort}</p><div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>{footerBrand?.socialLinks?.map((s) => (<a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}><FooterSocialIcon platform={asStr(s.platform)} /></a>))}</div></div>{footerColumns?.map((col) => (<div class="footer-col"><p class="footer-heading">{asStr(col.heading)}</p>{col.links?.length ? (<nav class="footer-links" aria-label={asStr(col.ariaLabel)}>{col.links.map((link) => (<a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>{asStr(link.label)}</a>))}</nav>) : null}{isContactFooterColumnHeading(col.heading) ? <FooterContactInfo variant="footer-column" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} /> : null}{col.hoursHeading ? <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p> : null}{col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}</div>))}</div></div>
  </footer>

  <FooterSupportBar copyrightHref={copyrightHref} companyName={companyName} footerSupport={footerSupport} />

  {galleryItems.length > 0 ? (
    <script define:vars={{ galleryItems }}>
      (function () {
        var items = galleryItems
        if (!items || !items.length) return

        var root = document.getElementById('projects-lightbox')
        if (!root) return

        var imgEl = root.querySelector('.projects-lightbox-img')
        var capEl = root.querySelector('.projects-lightbox-caption')
        var idxEl = root.querySelector('.projects-lightbox-index')
        var btnPrev = root.querySelector('.projects-lightbox-prev')
        var btnNext = root.querySelector('.projects-lightbox-next')
        var closeBtns = root.querySelectorAll('[data-lightbox-close]')

        var current = 0

        function show(i) {
          var n = items.length
          if (n === 0) return
          current = ((i % n) + n) % n
          var item = items[current]
          imgEl.src = item.src
          imgEl.alt = item.alt
          capEl.textContent = item.caption || ''
          if (idxEl) idxEl.textContent = String(current + 1) + ' / ' + n
        }

        function open(at) {
          show(at)
          root.hidden = false
          document.body.style.overflow = 'hidden'
          var closeBtn = root.querySelector('.projects-lightbox-close')
          if (closeBtn) closeBtn.focus()
        }

        function close() {
          root.hidden = true
          document.body.style.overflow = ''
        }

        document.querySelectorAll('.projects-gallery-thumb').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var i = parseInt(btn.getAttribute('data-photo-index'), 10)
            open(isNaN(i) ? 0 : i)
          })
        })

        btnPrev.addEventListener('click', function (e) {
          e.stopPropagation()
          show(current - 1)
        })
        btnNext.addEventListener('click', function (e) {
          e.stopPropagation()
          show(current + 1)
        })
        closeBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            close()
          })
        })

        document.addEventListener('keydown', function (e) {
          if (root.hidden) return
          if (e.key === 'Escape') {
            e.preventDefault()
            close()
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault()
            show(current - 1)
          } else if (e.key === 'ArrowRight') {
            e.preventDefault()
            show(current + 1)
          }
        })
      })()
    </script>
  ) : null}
</BaseLayout>
