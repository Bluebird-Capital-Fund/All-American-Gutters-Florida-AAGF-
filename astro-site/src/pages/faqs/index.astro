---
import BaseLayout from '../../layouts/BaseLayout.astro'
import OfferBarInner from '../../components/OfferBarInner.astro'
import FooterSocialIcon from '../../components/FooterSocialIcon.astro'
import FooterContactInfo from '../../components/FooterContactInfo.astro'
import FooterHoursRow from '../../components/FooterHoursRow.astro'
import FooterSupportBar from '../../components/FooterSupportBar.astro'
import SmsConsentNotice from '../../components/SmsConsentNotice.astro'
import SiteBreadcrumbs from '../../components/SiteBreadcrumbs.astro'
import SiteHeaderNav from '../../components/SiteHeaderNav.astro'
import { externalLinkAttrs } from '../../lib/external-link.js'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../../lib/footer-contact-heading.js'
import { getSiteSettings, getHomePage, mergeHeaderFromSettings } from '../../lib/site-settings.js'
import { sanitizeCmsHtml } from '../../lib/sanitize-cms-html.js'
import { aagfNavLogoUrl, aagfSiteLogoUrl } from '../../lib/brand-logos.js'
import { AAGF_FAQ_PAGE } from '../../lib/aagf-faq-page-data.js'
import { asStr, applyTemplate, formSubmitLabel, FOOTER_ESTIMATE_SECTION_INTRO_FALLBACK, mediaUrl } from '../../lib/sanity-strings.js'

let settings = {}
let homePage = {}
try {
  ;[settings, homePage] = await Promise.all([getSiteSettings(), getHomePage()])
} catch (err) {
  console.warn('[faqs] Sanity fetch failed; using fallback placeholders.', err)
}

const business = settings?.business ?? {}
const header = mergeHeaderFromSettings(settings, homePage?.header)
const footerEstimate = settings?.footerEstimate ?? homePage?.footerEstimate ?? {}
const footerEstimateFields = footerEstimate?.formFields ?? {}
const formsCfg = settings?.forms ?? {}
const footerBrand = settings?.footerBrand ?? homePage?.footerBrand ?? {}
const footerColumns = settings?.footerColumns ?? homePage?.footerColumns ?? []
const footerSupport = settings?.footerSupport ?? homePage?.footerSupport ?? {}

const companyName = asStr(business.companyName) || 'All American Gutters'
const phoneDisplay = asStr(business.phoneDisplay) || '(303) 000-0000'
const phoneTel = asStr(business.phoneTel) || '3030000000'
const email = asStr(business.email) || 'hello@example.com'
const address = asStr(business.addressShort) || 'Deerfield Beach, FL'
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business.descriptionShort)
const copyrightHref = asStr(business.copyrightSiteUrl) || '#'
const navLogoUrl = aagfNavLogoUrl()
const siteLogoUrl = aagfSiteLogoUrl()

const pageTitle = 'Straight answers before we step on a ladder | All American Gutters'
const pageDescription =
  'Answers to common South Florida gutter questions about cost, insurance, permits, cleaning, guards, storm protection, and replacement timing.'

const callLabelNav = applyTemplate(asStr(header.callCtaTemplate), { phoneDisplay }) || phoneDisplay
const logoAriaLabel = applyTemplate(asStr(header.logoAriaLabelTemplate), { companyName }) || companyName
const navItems = Array.isArray(header.navItems) ? header.navItems : []

const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '#'
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'

const faqData = AAGF_FAQ_PAGE.faq
const faqHeading = asStr(faqData?.headline) || 'Frequently Asked Questions'
const faqHeadingId = asStr(faqData?.headingId) || 'faq-page-heading'
const faqSections = Array.isArray(faqData?.sections) ? faqData.sections : []

let faqItemCounter = 0
const faqSectionsNumbered = faqSections.map((section) => ({
  heading: section.heading,
  items: section.items.map((item) => {
    faqItemCounter += 1
    return { ...item, n: faqItemCounter }
  }),
}))
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  theme={settings?.theme}
  forms={{ submitPath: asStr(settings?.forms?.submitPath) || '/api/lead' }}
>
  <header class="header">
    <div class="offer-bar">
      <div class="offer-bar-inner">
        <OfferBarInner offerBar={header?.offerBar} />
      </div>
    </div>
    <div class="header-nav">
      <SiteHeaderNav
        logoAriaLabel={logoAriaLabel}
        navLogoUrl={navLogoUrl}
        companyName={companyName}
        phoneTel={phoneTel}
        callLabelNav={callLabelNav}
        navItems={navItems}
        navDdPrefix="faq"
      />
    </div>
  </header>

  <SiteBreadcrumbs />

  <main>
    <section class="section secondary-page-section faq-intro" aria-labelledby="faq-intro-heading">
      <div class="container page-split page-split--media-end">
        <div class="secondary-prose">
          <h1 class="section-title section-title-secondary" id="faq-intro-heading">Straight answers before we step on a ladder</h1>
          <p>
            Florida homes deal with intense sun, salt air, and fast-moving summer storms. Your gutters work harder here than in most states. The questions below cover timing, insurance paperwork, guards, and licensing so you know what to expect before we visit.
          </p>
          <p>
            The team at All American Gutters has compiled helpful information to help homeowners understand their options and protect their properties from heavy rainfall, tropical storms, and drainage issues.
          </p>
          <p>
            Every roofline is a little different: tile versus shingle, oak canopy versus open sun, and whether you need larger downspouts or underground drainage. Use these answers as a starting point; during a walkthrough we will confirm measurements and recommend options that match your budget.
          </p>
          <p>
            Still unsure? Call the office or <a href="#contact">fill out our contact form</a>. Our team is happy to clarify anything before we schedule.
          </p>
        </div>
        <figure class="page-split__media">
          <img
            src={mediaUrl('Media (AAGF)/Images (AAGF)/all-american-gutters-gutter-cleaning-fort-lauderdale-fl-gutter-corner-drainage.webp')}
            alt="Corner downspout and drainage detail on a Plant City gutter installation"
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="container">
        <div class="faq-panel">
          <h2 class="section-title section-title-secondary" id={faqHeadingId}>{faqHeading}</h2>
          <div class="faq-sections">
            {faqSectionsNumbered.map((section, sectionIndex) => (
              <section class="faq-section-group" aria-labelledby={`faq-section-title-${sectionIndex}`}>
                <div class="faq-section-intro">
                  <h3 class="faq-section-title" id={`faq-section-title-${sectionIndex}`}>{section.heading}</h3>
                </div>
                <div class="faq-list" data-faq-accordion>
                  {section.items.map((item) => {
                    const btnId = `faq-page-btn-${item.n}`
                    const panelId = `faq-page-panel-${item.n}`
                    return (
                      <div class="faq-item">
                        <button
                          type="button"
                          class="faq-summary"
                          id={btnId}
                          aria-expanded="false"
                          aria-controls={panelId}
                        >
                          <span class="faq-question">{item.question}</span>
                          <span class="faq-chevron" aria-hidden="true"></span>
                        </button>
                        <div
                          class="faq-answer-outer"
                          id={panelId}
                          role="region"
                          aria-labelledby={btnId}
                          aria-hidden="true"
                        >
                          <div class="faq-answer" set:html={sanitizeCmsHtml(asStr(item.answerHtml))} />
                        </div>
                      </div>
                    )
                  })}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title">{asStr(footerEstimate?.headline) || 'Need Gutter Help in South Florida?'}</h2>
            <p>{asStr(footerEstimate?.intro) || FOOTER_ESTIMATE_SECTION_INTRO_FALLBACK}</p>
            <FooterContactInfo
              variant="estimate"
              phoneTel={phoneTel}
              phoneDisplay={phoneDisplay}
              email={email}
              address={address}
              addressHref={addressHref}
            />
          </div>
          <form
            class="contact-form"
            data-lead-form="faq-footer"
            action={universalFormAction}
            method={universalFormMethod}
          >
            <div class="contact-form-grid">
              <div class="contact-form-field">
                <label for="contact-name">
                  {asStr(universalFormFields?.nameLabel) || 'Name'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="contact-name" name="name" type="text" required autocomplete="name" />
              </div>
              <div class="contact-form-field">
                <label for="contact-email">
                  {asStr(universalFormFields?.emailLabel) || 'Email'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="contact-email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="contact-form-field">
                <label for="contact-phone">
                  {asStr(universalFormFields?.phoneLabel) || 'Phone'}{' '}
                  <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span>
                </label>
                <input id="contact-phone" name="phone" type="tel" required autocomplete="tel" />
              </div>
              <div class="contact-form-field">
                <label for="contact-location">{asStr(universalFormFields?.cityLabel) || 'City'}</label>
                <input id="contact-location" name="location" type="text" autocomplete="address-level2" />
              </div>
              <div class="contact-form-field contact-form-field-full">
                <label for="contact-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label>
                <textarea id="contact-message" name="message" rows="4"></textarea>
              </div>
            </div>
            <SmsConsentNotice />
            <button type="submit" class="btn btn-primary btn-lg">{formSubmitLabel(footerEstimateFields?.submitButton)}</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand-block footer-col">
          <img src={siteLogoUrl} alt={companyName} class="footer-logo" />
          <p class="footer-address">{descriptionShort}</p>
          <div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>
            {footerBrand?.socialLinks?.map((s) => (
              <a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}>
                <FooterSocialIcon platform={asStr(s.platform)} />
              </a>
            ))}
          </div>
        </div>
        {footerColumns?.map((col) => (
          <div class="footer-col">
            <p class="footer-heading">{asStr(col.heading)}</p>
            {col.links?.length ? (
              <nav class="footer-links" aria-label={asStr(col.ariaLabel)}>
                {col.links.map((link) => (
                  <a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>
                    {asStr(link.label)}
                  </a>
                ))}
              </nav>
            ) : null}
            {isContactFooterColumnHeading(col.heading) ? (
              <FooterContactInfo
                variant="footer-column"
                phoneTel={phoneTel}
                phoneDisplay={phoneDisplay}
                email={email}
                address={address}
                addressHref={addressHref}
              />
            ) : null}
            {col.hoursHeading ? <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p> : null}
            {col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}
          </div>
        ))}
      </div>
    </div>
  </footer>

  <FooterSupportBar copyrightHref={copyrightHref} companyName={companyName} footerSupport={footerSupport} />
</BaseLayout>
