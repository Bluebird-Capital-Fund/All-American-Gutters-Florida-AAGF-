---
import BaseLayout from '../../layouts/BaseLayout.astro'
import OfferBarInner from '../../components/OfferBarInner.astro'
import FooterSocialIcon from '../../components/FooterSocialIcon.astro'
import FooterContactInfo from '../../components/FooterContactInfo.astro'
import FooterHoursRow from '../../components/FooterHoursRow.astro'
import FooterSupportBar from '../../components/FooterSupportBar.astro'
import SmsConsentNotice from '../../components/SmsConsentNotice.astro'
import SiteBreadcrumbs from '../../components/SiteBreadcrumbs.astro'
import SiteHeaderNav from '../../components/SiteHeaderNav.astro'
import { externalLinkAttrs } from '../../lib/external-link.js'
import { googleBusinessProfileUrl, isContactFooterColumnHeading } from '../../lib/footer-contact-heading.js'
import { getSiteSettings, getHomePage, mergeHeaderFromSettings } from '../../lib/site-settings.js'
import { aagfNavLogoUrl, aagfSiteLogoUrl } from '../../lib/brand-logos.js'
import { asStr, applyTemplate, estimateCtaLabel, mediaUrl } from '../../lib/sanity-strings.js'

let settings = {}
let homePage = {}
try {
  ;[settings, homePage] = await Promise.all([getSiteSettings(), getHomePage()])
} catch (err) {
  console.warn('[about-us] Sanity fetch failed; using fallback placeholders.', err)
}

const business = settings?.business ?? {}
const header = mergeHeaderFromSettings(settings, homePage?.header)
const footerEstimate = settings?.footerEstimate ?? homePage?.footerEstimate ?? {}
const footerEstimateFields = footerEstimate?.formFields ?? {}
const formsCfg = settings?.forms ?? {}
const footerBrand = settings?.footerBrand ?? homePage?.footerBrand ?? {}
const footerColumns = settings?.footerColumns ?? homePage?.footerColumns ?? []
const footerSupport = settings?.footerSupport ?? homePage?.footerSupport ?? {}

const companyName = asStr(business.companyName) || 'All American Gutters'
const phoneDisplay = asStr(business.phoneDisplay) || '(303) 000-0000'
const phoneTel = asStr(business.phoneTel) || '3030000000'
const email = asStr(business.email) || 'hello@example.com'
const address = asStr(business.addressShort) || 'Deerfield Beach, FL'
const addressHref = googleBusinessProfileUrl(settings)
const descriptionShort = asStr(business.descriptionShort)
const copyrightHref = asStr(business.copyrightSiteUrl) || '#'
const navLogoUrl = aagfNavLogoUrl()
const siteLogoUrl = aagfSiteLogoUrl()

const callLabelNav = applyTemplate(asStr(header.callCtaTemplate), { phoneDisplay }) || phoneDisplay
const logoAriaLabel = applyTemplate(asStr(header.logoAriaLabelTemplate), { companyName }) || companyName
const navItems = Array.isArray(header.navItems) ? header.navItems : []

const team = homePage?.team ?? {}
const teamMembers = Array.isArray(team?.members) ? team.members : []
const teamRowPrimary = teamMembers.slice(0, 3)
const teamRowSecondary = teamMembers.slice(3, 5)

const aboutSectionHeadline = 'Built for South Florida homes and weather'
const aboutSectionLead =
  'All American Gutters installs and repairs South Florida seamless gutters, guards, and downspouts for homeowners across Broward and Palm Beach counties. From our base at 36 SW 8th Ct in Deerfield Beach, we bring honest estimates, on-time crews, and workmanship sized for heavy coastal rain.'
const aboutSectionBody = [
  'All American Gutters is a family-owned gutter company serving South Florida with installation, repair, replacement, gutter guards, and related drainage work designed for heavy rain and coastal wind. Crews measure rooflines carefully, fabricate seamless aluminum on-site when it fits the job, and leave your landscaping as tidy as we found it.',
  "We answer the phone, show up when we say we will, and explain your options in plain language. You'll receive a clear, line-item estimate with no high-pressure sales tactics. Whether you are replacing failing sections after a storm or upgrading guards before the next rainy season, we treat your home like our own.",
]
const aboutSectionBullets = [
  'Seamless aluminum fabricated on site for a custom fit',
  'Hangers and pitch tuned for South Florida storm seasons',
  'Color-matched accessories for stucco, siding, and stone homes',
]
const aboutSectionImage =
  'Media (AAGF)/Images (AAGF)/all-american-gutters-gutter-replacement-plantation-fl-front-elevation-gutter-install-stone-home.png'
const teamSectionHeadline = 'Meet the South Florida Crew'

const pageTitle = 'About Us | All American Gutters'
const pageDescription =
  'Family-owned gutter company in Deerfield Beach. Install, repair, guards, and downspouts across Broward and Palm Beach counties.'

const universalFormFields = footerEstimateFields
const universalFormAction = asStr(formsCfg?.submitPath) || asStr(footerEstimate?.formAction) || '#'
const universalFormMethod = asStr(footerEstimate?.formMethod) || 'post'
const universalRequiredIndicator = asStr(formsCfg?.requiredIndicator) || '*'
---

<BaseLayout title={pageTitle} description={pageDescription} theme={settings?.theme} forms={{ submitPath: asStr(settings?.forms?.submitPath) || '/api/lead' }}>
  <header class="header">
    <div class="offer-bar">
      <div class="offer-bar-inner">
        <OfferBarInner offerBar={header?.offerBar} />
      </div>
    </div>
    <div class="header-nav">
      <SiteHeaderNav
        logoAriaLabel={logoAriaLabel}
        navLogoUrl={navLogoUrl}
        companyName={companyName}
        phoneTel={phoneTel}
        callLabelNav={callLabelNav}
        navItems={navItems}
        navDdPrefix="about"
      />
    </div>
  </header>

  <SiteBreadcrumbs />

  <main>
    <section class="section about about-video">
      <div class="container about-grid">
        <div class="about-content">
          <h1 class="section-title">{aboutSectionHeadline}</h1>
          <p class="about-lead">{aboutSectionLead}</p>
          <div class="about-body-copy">
            {aboutSectionBody.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <ul class="about-list">
            {aboutSectionBullets.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </div>
        <figure class="about-visual about-body-figure">
          <img
            src={mediaUrl(aboutSectionImage)}
            alt="Seamless gutters and downspouts on a stone and stucco South Florida home"
            width="480"
            height="640"
            loading="lazy"
            decoding="async"
            class="about-img about-img--portrait"
          />
        </figure>
      </div>
    </section>

    {teamMembers.length > 0 ? (
      <section class="section our-team about-team" aria-labelledby="about-team-heading">
        <div class="container">
          <h2 class="section-title" id="about-team-heading">{teamSectionHeadline}</h2>
          <div class="about-team-grid">
            <div class="about-team-row about-team-row--primary">
              {teamRowPrimary.map((m) => {
                const memLoc = asStr(m.location)
                const personName = asStr(m.personName)
                const isOwnerCard =
                  asStr(m._key) === 'aagf-team-owner' || personName === 'Bertram Hamilton'
                return (
                  <article
                    class:list={[
                      'team-card',
                      personName && 'team-card--named',
                      isOwnerCard && 'team-card--owner',
                    ]}
                  >
                    <img
                      src={mediaUrl(asStr(m.imageSrc))}
                      alt={asStr(m.imageAlt)}
                      width="640"
                      height="480"
                      loading="lazy"
                      decoding="async"
                    />
                    {personName ? (
                      <>
                        <h3>{personName}</h3>
                        <p class="team-location">{asStr(m.name)}</p>
                      </>
                    ) : (
                      <>
                        <h3>{asStr(m.name)}</h3>
                        {memLoc ? <p class="team-location">{memLoc}</p> : null}
                      </>
                    )}
                    <p>{asStr(m.bio)}</p>
                  </article>
                )
              })}
            </div>
            {teamRowSecondary.length > 0 ? (
              <div class="about-team-row about-team-row--secondary">
                {teamRowSecondary.map((m) => {
                  const memLoc = asStr(m.location)
                  const personName = asStr(m.personName)
                  return (
                    <article class:list={['team-card', personName && 'team-card--named']}>
                      <img
                        src={mediaUrl(asStr(m.imageSrc))}
                        alt={asStr(m.imageAlt)}
                        width="640"
                        height="480"
                        loading="lazy"
                        decoding="async"
                      />
                      {personName ? (
                        <>
                          <h3>{personName}</h3>
                          <p class="team-location">{asStr(m.name)}</p>
                        </>
                      ) : (
                        <>
                          <h3>{asStr(m.name)}</h3>
                          {memLoc ? <p class="team-location">{memLoc}</p> : null}
                        </>
                      )}
                      <p>{asStr(m.bio)}</p>
                    </article>
                  )
                })}
              </div>
            ) : null}
          </div>
        </div>
      </section>
    ) : null}
  </main>

  <footer class="footer">
    <section id="contact" class="section contact footer-estimate">
      <div class="container">
        <div class="contact-wrapper">
          <div class="contact-info">
            <h2 class="section-title">{asStr(footerEstimate?.headline) || 'Need Gutter Help in South Florida?'}</h2>
            <p>{asStr(footerEstimate?.intro) || 'Contact us for fast service and straightforward estimates.'}</p>
            <FooterContactInfo variant="estimate" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} />
          </div>
          <form class="contact-form" data-lead-form="about-footer" action={universalFormAction} method={universalFormMethod}>
            <div class="contact-form-grid">
              <div class="contact-form-field"><label for="about-contact-name">{asStr(universalFormFields?.nameLabel) || 'Name'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="about-contact-name" name="name" type="text" required autocomplete="name" /></div>
              <div class="contact-form-field"><label for="about-contact-email">{asStr(universalFormFields?.emailLabel) || 'Email'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="about-contact-email" name="email" type="email" required autocomplete="email" /></div>
              <div class="contact-form-field"><label for="about-contact-phone">{asStr(universalFormFields?.phoneLabel) || 'Phone'} <span class="required-mark" aria-hidden="true">{universalRequiredIndicator}</span></label><input id="about-contact-phone" name="phone" type="tel" required autocomplete="tel" /></div>
              <div class="contact-form-field"><label for="about-contact-location">{asStr(universalFormFields?.cityLabel) || 'City'}</label><input id="about-contact-location" name="location" type="text" autocomplete="address-level2" /></div>
              <div class="contact-form-field contact-form-field-full"><label for="about-contact-message">{asStr(universalFormFields?.projectDetailsLabel) || 'Project Details'}</label><textarea id="about-contact-message" name="message" rows="4"></textarea></div>
            </div>
            <SmsConsentNotice />
            <button type="submit" class="btn btn-primary btn-lg">{estimateCtaLabel(footerEstimateFields?.submitButton)}</button>
          </form>
        </div>
      </div>
    </section>
    <div class="container"><div class="footer-inner"><div class="footer-brand-block footer-col"><img src={siteLogoUrl} alt={companyName} class="footer-logo" /><p class="footer-address">{descriptionShort}</p><div class="footer-social" aria-label={asStr(footerBrand?.socialAriaLabel)}>{footerBrand?.socialLinks?.map((s) => (<a href={asStr(s.href)} aria-label={asStr(s.ariaLabel)} {...externalLinkAttrs(asStr(s.href))}><FooterSocialIcon platform={asStr(s.platform)} /></a>))}</div></div>{footerColumns?.map((col) => (<div class="footer-col"><p class="footer-heading">{asStr(col.heading)}</p>{col.links?.length ? (<nav class="footer-links" aria-label={asStr(col.ariaLabel)}>{col.links.map((link) => (<a href={asStr(link.href)} {...externalLinkAttrs(asStr(link.href))}>{asStr(link.label)}</a>))}</nav>) : null}{isContactFooterColumnHeading(col.heading) ? <FooterContactInfo variant="footer-column" phoneTel={phoneTel} phoneDisplay={phoneDisplay} email={email} address={address} addressHref={addressHref} /> : null}{col.hoursHeading ? <p class="footer-heading footer-hours-heading">{asStr(col.hoursHeading)}</p> : null}{col.hoursText ? <FooterHoursRow hoursText={col.hoursText} /> : null}</div>))}</div></div>
  </footer>

  <FooterSupportBar copyrightHref={copyrightHref} companyName={companyName} footerSupport={footerSupport} />
</BaseLayout>
